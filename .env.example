# Meta Model API (hub only — never NEXT_PUBLIC_)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
ASR_WS_URL=wss://api.meta.ai/v1/asr/realtime

# Supabase (hub)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=decks
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hub
HUB_PORT=8787
HUB_HOST=127.0.0.1
DATA_DIR=.data
LOG_LEVEL=info

# Web -> hub endpoints (defaults match HUB_PORT above)
NEXT_PUBLIC_HUB_URL=http://localhost:8787
NEXT_PUBLIC_HUB_WS=ws://localhost:8787/ws
HUB_URL=http://localhost:8787
